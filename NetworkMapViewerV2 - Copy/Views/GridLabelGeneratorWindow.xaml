<Window x:Class="NetworkMapViewerV2.Views.GridLabelGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Grid Label Generator" Height="450" Width="600" 
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray">
            <Run FontWeight="Bold" Text="Format Rules:"/> Use commas to separate columns.&#x0a;
            • <Run FontWeight="Bold" Text="0"/> = Skip empty space&#x0a;
            • <Run FontWeight="Bold" Text="1:Color:Text"/> = Label with color (e.g., 1:Blue:Server Rack A)
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="2">
                <TextBlock Text="Width:" FontWeight="Bold"/>
                <TextBox x:Name="txtWidth" Text="125"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="2">
                <TextBlock Text="Height:" FontWeight="Bold"/>
                <TextBox x:Name="txtHeight" Text="120"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="2">
                <TextBlock Text="Start X:" FontWeight="Bold"/>
                <TextBox x:Name="txtStartX" Text="110"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="2">
                <TextBlock Text="Start Y:" FontWeight="Bold"/>
                <TextBox x:Name="txtStartY" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="2">
                <TextBlock Text="Gap X:" FontWeight="Bold"/>
                <TextBox x:Name="txtGapX" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="5" Margin="2">
                <TextBlock Text="Gap Y:" FontWeight="Bold"/>
                <TextBox x:Name="txtGapY" Text="10"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="txtGridData" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Generate Labels" Width="120" Height="30" Margin="0,0,10,0" IsDefault="True" Click="BtnGenerate_Click"/>
            <Button Content="Cancel" Width="80" Height="30" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>