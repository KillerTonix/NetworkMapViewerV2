<Window x:Class="NetworkMapViewerV2.Views.LabelPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Label Properties" Height="500" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F0F0" KeyDown="Window_KeyDown">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtText" Grid.Row="0" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" Margin="5" Padding="4"
                 FontFamily="Consolas" FontSize="14"/>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <GroupBox Header="Align &amp; Size" Margin="0,0,0,10" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Horizontal:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <ComboBox x:Name="cmbHAlign" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Left" Tag="0"/>
                            <ComboBoxItem Content="Right" Tag="1"/>
                            <ComboBoxItem Content="Center" Tag="2"/>
                        </ComboBox>

                        <TextBlock Text="Vertical:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <ComboBox x:Name="cmbVAlign" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" SelectedIndex="0">
                            <ComboBoxItem Content="Top" Tag="0"/>
                            <ComboBoxItem Content="Bottom" Tag="1"/>
                            <ComboBoxItem Content="Center" Tag="2"/>
                        </ComboBox>

                        <TextBlock Text="Width:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="txtWidth" Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" Padding="2" ToolTip="Leave empty or 0 for Auto-size"/>

                        <TextBlock Text="Height:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="txtHeight" Grid.Row="3" Grid.Column="1" Margin="0,5,0,5" Padding="2" ToolTip="Leave empty or 0 for Auto-size"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Brush (Background)" Margin="0,0,0,10" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <xctk:ColorPicker Grid.Column="1" x:Name="cpBgColor"   />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Frame (Border)" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <xctk:ColorPicker Grid.Column="1" x:Name="cpBorderColor" />
                    </Grid>
                </GroupBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <GroupBox Header="Font Settings" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Family:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="txtFontFamily" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" Padding="2"/>

                        <TextBlock Text="Size:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox x:Name="txtFontSize" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" Padding="2"/>

                        <TextBlock Text="Color:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <xctk:ColorPicker Grid.Row="2" Grid.Column="1" x:Name="cpFontColor" />

                        <TextBlock Text="Effects:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,15,10,5"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,15,0,5">
                            <ToggleButton x:Name="btnBold" Content="B" FontWeight="Bold" Width="24" Height="24" Margin="0,0,5,0"/>
                            <ToggleButton x:Name="btnItalic" Content="I" FontStyle="Italic" Width="24" Height="24" Margin="0,0,5,0"/>
                            <ToggleButton x:Name="btnUnderline" Content="U" Width="24" Height="24" Margin="0,0,5,0">
                                <ToggleButton.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="U" TextDecorations="Underline"/>
                                    </DataTemplate>
                                </ToggleButton.ContentTemplate>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,5">
            <Button Content="✔️ OK" Width="80" Height="25" Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="❌ Cancel" Width="80" Height="25" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>