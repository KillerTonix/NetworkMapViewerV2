<Window x:Class="NetworkMapViewerV2.Views.DevicePropertiesWindow"        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Properties" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F0F0" KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White" BorderBrush="#CCCCCC">
            <TabItem Header="📝 Description">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Name Field -->
                    <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtName" Grid.Row="1" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                    <!-- Text in Hint Field -->
                    <TextBlock Grid.Row="2" Text="Text in hint" Margin="0,0,0,2"/>

                    <!-- Fake Rich Text Toolbar (For visual similarity) -->
                    <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1,1,1,0" Background="#F0F0F0" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnBold" Content="B" FontWeight="Bold" Width="24" Height="24" Margin="2,0" Click="BtnBold_Click" Cursor="Hand" Background="#E0E0E0"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="txtHint" Grid.Row="4" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" BorderBrush="#CCCCCC" Margin="0,0,0,10" Padding="2" PreviewKeyDown="txtHint_PreviewKeyDown"/>
                    <!-- Image in Hint Field -->
                    <TextBlock Grid.Row="5" Text="Image in hint" Margin="0,0,0,2"/>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtImagePath" Grid.Column="0" VerticalAlignment="Center" Padding="2"/>
                        <Button x:Name="BtnBrowseImage" Grid.Column="1" Content="📂" Width="30" Margin="5,0,0,0" Click="BtnBrowseImage_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🖥️ Type">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,0,10,15"/>
                    <ComboBox x:Name="cmbType" Grid.Row="0" Grid.Column="1" Margin="0,0,0,15" VerticalAlignment="Center" Padding="4" SelectionChanged="CmbType_SelectionChanged"/>

                    <TextBlock x:Name="lblAddress" Grid.Row="1" Grid.Column="0" Text="Address" VerticalAlignment="Center" Margin="0,0,10,15"/>
                    <TextBox x:Name="txtAddress" Grid.Row="1" Grid.Column="1" Margin="0,0,0,15" VerticalAlignment="Center" Padding="4" IsVisibleChanged="txtAddress_IsVisibleChanged"/>

                    <TextBlock x:Name="lblTargetMap" Text="Map file" Grid.Row="2" Grid.Column="0" Margin="0,0,0,2" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbTargetMap" Grid.Row="2" Grid.Column="1"  VerticalAlignment="Center" Padding="4"/>

                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✔️ OK" Width="80" Height="25" Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button Content="❌ Cancel" Width="80" Height="25" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>