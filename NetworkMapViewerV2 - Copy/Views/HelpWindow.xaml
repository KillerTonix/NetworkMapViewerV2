<Window x:Class="NetworkMapViewerV2.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkeys &amp; About" Height="550" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="#1E1E1E" Foreground="White">

    <Grid Margin="10">
        <TabControl x:Name="TabControlObject" Background="#2D2D30" BorderThickness="0" Foreground="White">

            <TabItem Header="⌨️ Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15,5,25,15">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" x:Key="HeaderStyle">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Margin" Value="0,15,0,10"/>
                                <Setter Property="TextDecorations" Value="Underline"/>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="KeyStyle">
                                <Setter Property="Foreground" Value="#569CD6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Width" Value="160"/>
                            </Style>
                            <Style TargetType="TextBlock" x:Key="DescStyle">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="File &amp; Tab Operations" Style="{StaticResource HeaderStyle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + N" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Create a New Map" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + O" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open an existing Map" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + S" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Save current map to database" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + R" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Reload map from database" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + W" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Close current tab" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alt + F4" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Exit Application" Style="{StaticResource DescStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Editing &amp; Map Layout" Style="{StaticResource HeaderStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + E" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Toggle Edit Mode ON / OFF" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + G" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Toggle Grid Snapping / Visibility" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F2" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Properties for selected item" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Delete" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Remove selected item(s) from map" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + C / Ctrl + V" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Copy / Paste items (with offset)" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + Shift + V" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Paste in Place (exact original coordinates)" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + H" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Find and Replace text/IPs" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + F2" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Find and recover Out-of-Bounds devices" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alt + A" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Auto-Align: Snaps Devices to nearest Label" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alt + Arrows / C / S" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Manual Alignment: Align edges/centers of items" Style="{StaticResource DescStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Network &amp; Diagnostics" Style="{StaticResource HeaderStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F5" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Start Ping process for map devices" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F4" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Stop Ping process" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + F5" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Ping Options/Settings" Style="{StaticResource DescStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Tools, Logs &amp; Search" Style="{StaticResource HeaderStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + F" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Toggle Global Search" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + Shift + F" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Search Options" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F11" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Notifications Panel" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + F11" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Notification Options" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F12" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Generate Network Report" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + L" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="View Action/Audit Logs" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl + K" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Open Application Options" Style="{StaticResource DescStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Help" Style="{StaticResource HeaderStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F1" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Show About Window" Style="{StaticResource DescStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shift + F1" Style="{StaticResource KeyStyle}"/>
                            <TextBlock Text="Show Hotkeys Window" Style="{StaticResource DescStyle}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ℹ️ About">
                <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Network Map Viewer" FontSize="26" Foreground="#CCCCCC" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Version 2.0" FontSize="14" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Developed by: Artur Tonoyan" FontSize="14" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="A professional WPF administration tool for mapping IT infrastructure, featuring live WMI/PsExec hardware scanning and active directory integration." 
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#AAAAAA" MaxWidth="350"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>