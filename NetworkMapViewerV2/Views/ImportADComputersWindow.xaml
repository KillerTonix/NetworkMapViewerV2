<Window x:Class="NetworkMapViewerV2.Views.ImportADComputersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Recent AD Computers" Height="500" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#E2E8F0" TextElement.Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Blue Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Info -->
                <TextBlock Grid.Row="0" Text="Import Active Directory Computers" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtSummary" Grid.Row="1" Text="Select devices added in the last 15 days to place on the map." Foreground="#475569" FontSize="12" Margin="0,0,0,12"/>

                <!-- Computers DataGrid -->
                <DataGrid x:Name="dgComputers" Grid.Row="2"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          Foreground="#0F172A" 
                          Background="#FFFFFF"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#E2E8F0"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeight="34"
                          HeadersVisibility="Column"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <!-- CheckBox Select Column -->
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                            <DataGridCheckBoxColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.HeaderStyle>
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>

                        <DataGridTextColumn Header="Computer Name" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="160"/>
                        <DataGridTextColumn Header="Date Created (AD)" Binding="{Binding WhenCreated, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer / Action Controls -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select All / None Quick Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Select All" Width="85" Height="28" Margin="0,0,6,0" Click="BtnSelectAll_Click" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Unselect All" Width="85" Height="28" Click="BtnUnselectAll_Click" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- Dialog Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add Selected to Map" Width="150" Height="32" Margin="0,0,8,0" Click="BtnAdd_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                        <Button Content="Cancel" Width="85" Height="32" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>