<Window x:Class="NetworkMapViewerV2.Views.GridLabelGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Grid Label Generator" Height="500" Width="640" 
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" KeyDown="Window_KeyDown"
        Background="#E2E8F0" TextElement.Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Format Rules Banner -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#475569" FontSize="11" LineHeight="16">
                        <Run FontWeight="Bold" Foreground="#0F172A" Text="Format Rules:"/> Use commas to separate columns.&#x0a;
                        - <Run FontWeight="Bold" Foreground="#0F172A" Text="0"/> = Skip empty space&#x0a;
                        - <Run FontWeight="Bold" Foreground="#0F172A" Text="1:Color:Text"/> = Label with color (e.g., 1:Blue:Server Rack A)
                    </TextBlock>
                </Border>

                <!-- Numeric Parameter Inputs -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="2">
                        <TextBlock Text="Width:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtWidth" Text="125" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="2">
                        <TextBlock Text="Height:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtHeight" Text="120" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="2">
                        <TextBlock Text="Start X:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtStartX" Text="110" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="2">
                        <TextBlock Text="Start Y:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtStartY" Text="0" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="2">
                        <TextBlock Text="Gap X:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtGapX" Text="0" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="2">
                        <TextBlock Text="Gap Y:" FontWeight="SemiBold" Foreground="#334155" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtGapY" Text="10" Height="26"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="txtGridData" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Generate Labels" Width="125" Height="30" Margin="0,0,8,0" IsDefault="True" Click="BtnGenerate_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Cancel" Width="85" Height="30" IsCancel="True" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>