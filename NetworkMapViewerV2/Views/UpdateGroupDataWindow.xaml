<Window x:Class="NetworkMapViewerV2.Views.UpdateGroupDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Devices Data" Height="250" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White" WindowStyle="ToolWindow">

    <StackPanel Margin="20">
        <TextBlock Text="Target Device Group:" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbGroups" Height="28" Background="#2D2D30" Foreground="Black" 
                  DisplayMemberPath="DisplayText" SelectedValuePath="GroupId"/>

        <TextBlock Text="Auto-Fill Script:" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,15,0,5"/>
        <ComboBox x:Name="cmbScripts" Height="28" Background="#2D2D30" Foreground="Black"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click" 
                    Background="#3F3F46" Foreground="White" BorderThickness="0"/>
            <Button Content="Run Update" Width="100" Height="30" Click="BtnRun_Click" 
                    Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>