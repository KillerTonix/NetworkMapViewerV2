<Window x:Class="NetworkMapViewerV2.Views.SpotlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Search" Height="100" Width="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">

    <!-- Modern High-Contrast Light Container -->
    <Border Background="#FFFFFF" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="#0F172A" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="🔎" FontSize="24" VerticalAlignment="Center" Margin="18,0,12,0" Foreground="#2563EB"/>

            <TextBox x:Name="txtSpotlightSearch" Grid.Column="1" Background="Transparent" 
                     BorderThickness="0" Foreground="#0F172A" FontSize="22" FontWeight="SemiBold"
                     VerticalAlignment="Center" CaretBrush="#2563EB" Margin="0,0,20,0"/>
        </Grid>
    </Border>
</Window>