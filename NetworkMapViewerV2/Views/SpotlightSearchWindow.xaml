<Window x:Class="NetworkMapViewerV2.Views.SpotlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Search" Height="100" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">

    <!-- The Drop Shadow Container -->
    <Border Background="#2D2D30" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="🔎" FontSize="26" VerticalAlignment="Center" Margin="20,0,15,0" Foreground="#999999"/>

            <TextBox x:Name="txtSpotlightSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                     Foreground="White" FontSize="26" VerticalAlignment="Center" 
                     CaretBrush="White" Margin="0,0,20,0"/>
        </Grid>
    </Border>
</Window>