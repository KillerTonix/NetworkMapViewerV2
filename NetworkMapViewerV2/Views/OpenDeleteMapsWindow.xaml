<Window x:Class="NetworkMapViewerV2.Views.OpenDeleteMapsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Title="Manage Maps" Height="450" Width="400"        >

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a Map:" FontSize="16" Margin="0,0,0,10"/>

        <!-- Maps List -->
        <ListBox x:Name="lstMaps" Grid.Row="1"  
                 BorderBrush="#3F3F46" BorderThickness="1" Padding="5" FontSize="14" 
                 SelectedValuePath="Key" DisplayMemberPath="Value"
                 MouseDoubleClick="LstMaps_MouseDoubleClick"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnDelete" Content="Delete" Width="80" Margin="0,0,103,0" Padding="0,5"
                Background="#CC4A31" Foreground="White" Cursor="Hand" Click="BtnDelete_Click"/>

            <Button x:Name="btnOpen" Content="Open Map" Width="90" Margin="0,0,10,0" Padding="0,5"                     
                    Click="BtnOpen_Click" IsDefault="True"/>

            <Button x:Name="btnCancel" Content="Cancel" Width="80" Padding="0,5"                    
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>