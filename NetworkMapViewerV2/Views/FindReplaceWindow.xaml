<Window x:Class="NetworkMapViewerV2.Views.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find and Replace" Height="220" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#2D2D30" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Find what:" Grid.Row="0" Margin="0,0,0,5" Foreground="#CCCCCC"/>
        <TextBox x:Name="txtFind" Grid.Row="1" Height="26" Padding="3" Margin="0,0,0,15"/>

        <TextBlock Text="Replace with:" Grid.Row="2" Margin="0,0,0,5" Foreground="#CCCCCC"/>
        <TextBox x:Name="txtReplace" Grid.Row="3" Height="26" Padding="3" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Replace All" Width="90" Height="28" Margin="0,0,10,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="BtnReplace_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="28" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>