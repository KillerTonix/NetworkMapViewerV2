<Window x:Class="NetworkMapViewerV2.Views.IPAMWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPAM - IP Address Management" Height="700" Width="1180" MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="#E2E8F0" TextElement.Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Blue Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar list item: one saved CIDR range -->
        <Style x:Key="SubnetItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status pill: background colour per IpState -->
        <Style x:Key="StatePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Used">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="FreeNoReply">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ActiveNotOnMap">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status pill: text colour per IpState -->
        <Style x:Key="StatePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Used">
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="FreeNoReply">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ActiveNotOnMap">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR: saved CIDR ranges ═══════════════ -->
        <Border x:Name="pnlSidebar" Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Saved ranges" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Button x:Name="btnSubnetAdd" Grid.Column="1" Content="+ Add" Width="64" Height="26"
                            Click="BtnSubnetAdd_Click" Style="{StaticResource PrimaryButton}"
                            ToolTip="Save a CIDR range with a name (starts from the range currently in the box)"/>
                </Grid>

                <TextBlock x:Name="txtSubnetError" Grid.Row="1" Foreground="#B91C1C" FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                <!-- List of saved ranges (click one to show its addresses) -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="lstSubnets"
                             BorderThickness="0" Background="Transparent"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SubnetItem}"
                             SelectionChanged="LstSubnets_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Cidr}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="txtSubnetEmpty" Text="No saved ranges yet.&#x0A;Type a CIDR on the right and press + Add to name and keep it here."
                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="4,8,4,0"
                               VerticalAlignment="Top" Visibility="Collapsed"/>
                </Grid>

                <!-- Add / edit form -->
                <Border x:Name="pnlSubnetEditor" Grid.Row="3" Visibility="Collapsed"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txtSubnetEditorTitle" Text="New range" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                        <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtSubnetName" Height="28" VerticalContentAlignment="Center" MaxLength="200"
                                 PreviewKeyDown="SubnetEditor_PreviewKeyDown" ToolTip="e.g. Montreal Branch"/>

                        <TextBlock Text="CIDR" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtSubnetCidr" Height="28" VerticalContentAlignment="Center"
                                 PreviewKeyDown="SubnetEditor_PreviewKeyDown" ToolTip="e.g. 192.168.102.0/24"/>

                        <TextBlock x:Name="txtSubnetEditorError" Foreground="#B91C1C" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSubnetSave" Grid.Column="0" Content="Save" Height="28"
                                    Click="BtnSubnetSave_Click" Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="btnSubnetCancel" Grid.Column="2" Content="Cancel" Height="28"
                                    Click="BtnSubnetCancel_Click" Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Edit / delete the selected range -->
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnSubnetEdit" Grid.Column="0" Content="Edit" Height="28"
                            Click="BtnSubnetEdit_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                    <Button x:Name="btnSubnetDelete" Grid.Column="2" Content="Delete" Height="28"
                            Click="BtnSubnetDelete_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN: used / free addresses ═══════════════ -->
        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="IP Address Usage" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,10"/>

                <!-- CIDR input + filter -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="CIDR range:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCidr" Grid.Column="1" Height="28" VerticalContentAlignment="Center" FontSize="13"
                             ToolTip="Example: 192.168.102.0/24"/>
                    <Button x:Name="btnShow" Grid.Column="2" Content="Show IPs" Width="90" Height="28" Margin="8,0,0,0"
                            Click="BtnShow_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>

                    <TextBlock Grid.Column="4" Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbFilter" Grid.Column="5" Height="28" VerticalContentAlignment="Center"
                              SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="All addresses" Tag="All" IsSelected="True"/>
                        <ComboBoxItem Content="Used (on a map)" Tag="Used"/>
                        <ComboBoxItem Content="Free (not on any map)" Tag="Free"/>
                        <ComboBoxItem Content="Free · no ping reply" Tag="NoReply"/>
                        <ComboBoxItem Content="Answers ping · not on any map" Tag="Active"/>
                    </ComboBox>
                </Grid>

                <!-- Summary / validation message -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock x:Name="txtMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="txtSummary" Foreground="#475569" FontSize="12" TextWrapping="Wrap"
                               Text="Enter a CIDR range and press Show IPs, or pick a saved range on the left."/>
                </StackPanel>

                <!-- IP grid -->
                <!-- IP grid -->
                <DataGrid x:Name="dgIps" Grid.Row="3"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="False"
          SelectionMode="Extended"
          Foreground="#0F172A"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#E2E8F0"
          RowBackground="#FFFFFF"
          AlternatingRowBackground="#F8FAFC"
          RowHeight="32"
          HeadersVisibility="Column"
          CellEditEnding="DgIps_CellEditEnding"
          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <!-- IP Address (Read Only) -->
                        <DataGridTextColumn Header="IP Address" 
                            Binding="{Binding Address}" 
                            SortMemberPath="SortKey" 
                            Width="130" 
                            IsReadOnly="True" 
                            FontWeight="SemiBold"/>

                        <!-- Status (Read Only) -->
                        <DataGridTemplateColumn Header="Status" SortMemberPath="State" Width="180" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatePill}">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StatePillText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Device Name -->
                        <DataGridTextColumn Header="Device Name" 
                            Binding="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" 
                            Width="140" 
                            IsReadOnly="False"/>

                        <!-- Device Type Selector -->
                        <DataGridTemplateColumn Header="Device Type" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceType}" VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DataContext.AvailableDeviceTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsEditable="True" Height="26" VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Map Selector -->
                        <DataGridTemplateColumn Header="Map Name" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MapName}" VerticalAlignment="Center" Padding="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding MapName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DataContext.AvailableMaps, RelativeSource={RelativeSource AncestorType=Window}}"
                              IsEditable="False" Height="26" VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Note (Editable Text) -->
                        <DataGridTextColumn Header="Note" 
                            Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                            Width="*" 
                            IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Caveat -->
                <TextBlock Grid.Row="4" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="&quot;Used&quot; comes from devices saved in the database (unsaved map edits are not included). &quot;No ping reply&quot; only means nothing answered: a device that blocks ping (e.g. a firewalled PC) can still hold that address, so confirm before assigning it."/>

                <!-- Footer / actions -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="pbPing" Width="200" Height="12" Visibility="Collapsed" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtProgress" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnPing" Content="Ping Free IPs" Width="130" Height="32" Margin="0,0,8,0"
                                Click="BtnPing_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                ToolTip="Send ping to every address that is not on a map"/>
                        <Button x:Name="btnStop" Content="Stop" Width="85" Height="32" Margin="0,0,8,0"
                                Click="BtnStop_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                        <Button x:Name="btnClose" Content="Close" Width="85" Height="32"
                                Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>