<Window x:Class="NetworkMapViewerV2.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkeys &amp; About" Height="600" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="#1E1E1E" Foreground="White">

    <Grid>
        <TabControl x:Name="TabControlObject" Background="#2D2D30" BorderThickness="0" Foreground="White">

            <!-- HOTKEYS TAB -->
            <TabItem Header="⌨️ Hotkeys">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="#3F3F46" CornerRadius="5" Padding="5" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="🔍 Search shortcuts..." Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtSearch}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="txtSearch" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Padding="5" TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Dynamic Hotkeys List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                        <ItemsControl ItemsSource="{Binding HotkeysView}">

                            <!-- Grouping Header Style -->
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" FontWeight="Bold" FontSize="14" Margin="0,15,0,10" TextDecorations="Underline"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <!-- Individual Hotkey Style -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding KeyCombo}" Foreground="#569CD6" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ABOUT TAB -->
            <TabItem Header="ℹ️ About">
                <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Network Map Viewer" FontSize="28" Foreground="#E0E0E0" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Version 2.0" FontSize="14" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <Border Background="#3F3F46" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <TextBlock Text="Developed by: Artur Tonoyan" FontSize="15" FontWeight="Medium" Foreground="#569CD6" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="A professional WPF administration tool for mapping IT infrastructure, featuring live WMI/PsExec hardware scanning and active directory integration." 
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#AAAAAA" MaxWidth="380" LineHeight="20"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>