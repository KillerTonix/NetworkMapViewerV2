<Window x:Class="NetworkMapViewerV2.Views.NewMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Title="Create New Map" Height="250" Width="360"
        Background="#1E1E1E" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Map Name Input -->
        <TextBlock Grid.Row="0" Text="Enter a name for the new tab:" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,8"/>
        <TextBox x:Name="txtMapName" Grid.Row="1" Text="New Map" FontSize="14" Padding="5" 
                 Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46"/>

        <!-- Map Type Input -->
        <TextBlock Grid.Row="2" Text="Select map type:" Foreground="#E0E0E0" FontSize="14" Margin="0,15,0,8"/>
        <ComboBox x:Name="cmbMapType" Grid.Row="3" FontSize="14" Padding="5" Foreground="Black" BorderBrush="#3F3F46" SelectedIndex="0">
            <ComboBoxItem Content="Head Office"/>
            <ComboBoxItem Content="Branch"/>
        </ComboBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Create" Width="80" Margin="0,0,10,0" Padding="0,5" 
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" 
                    Click="BtnCreate_Click" IsDefault="True"/>

            <Button Content="Cancel" Width="80" Padding="0,5" 
                    Background="#3F3F46" Foreground="White" BorderThickness="0" Cursor="Hand" 
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>