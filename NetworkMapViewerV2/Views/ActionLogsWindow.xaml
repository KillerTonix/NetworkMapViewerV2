<Window x:Class="NetworkMapViewerV2.Views.ActionLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Logs" Height="500" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#E2E8F0" TextElement.Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- System Selection Color Overrides -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#93C5FD"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#BFDBFE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E3A8A"/>

        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#93C5FD"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#93C5FD"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <!-- White Card Container -->
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12">
            <DataGrid x:Name="dgLogs" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"                  
                      Foreground="#0F172A" 
                      Background="#FFFFFF"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="32"
                      HeadersVisibility="Column">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeStamp}" Width="140"/>
                    <DataGridTextColumn Header="Map Name" Binding="{Binding MapName}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="90"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="90"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Detailed Changes" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>