<Window x:Class="NetworkMapViewerV2.Views.ActionLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Logs" Height="450" Width="800"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White">
    <Grid Margin="10">
        <DataGrid x:Name="dgLogs" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#2D2D30" RowBackground="#2D2D30" AlternatingRowBackground="#3E3E42"
                  Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#555"
                  BorderThickness="0">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderBrush" Value="#555"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="140"/>
                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="80"/>
                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="80"/>
                <DataGridTextColumn Header="ID" Binding="{Binding RecordId}" Width="50"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
