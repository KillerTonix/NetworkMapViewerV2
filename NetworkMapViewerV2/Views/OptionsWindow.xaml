<Window x:Class="NetworkMapViewerV2.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkMapViewerV2"
        xmlns:views="clr-namespace:NetworkMapViewerV2.Views"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="Options" Height="630" Width="820"
        Background="#E2E8F0" TextElement.Foreground="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Tab Control Custom Light Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="Transparent" 
                                BorderThickness="0,0,0,2" 
                                BorderBrush="Transparent" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="0,0,6,0"
                                Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern High-Contrast TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern High-Contrast ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Tactile Gray) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Card Container -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN TABS -->
        <TabControl x:Name="SettingsTC" Grid.Row="0">

            <!-- 1. COMMANDS TAB -->
            <TabItem Header="⚙️ Commands">
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Manage External Commands" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="CommandsListBox" Grid.Column="0" Margin="0,0,12,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button Click="AddCommandButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddCoppyCommandButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📑" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Copy" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="RemoveCommandButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="EditCommandButton_CLick" Margin="0,0,0,12" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="MoveUpCommandButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬆️" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Move Up" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="MoveDownCommandButton_Click" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Move Down" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 2. DEVICE TYPES TAB -->
            <TabItem Header="💻 Device Types">
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Manage Custom Device Types" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="DeviceGroupsListBox" Grid.Column="0" Margin="0,0,12,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="🖥️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultCommand}" Foreground="#475569" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button Click="AddGroupButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="RemoveGroupButton_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="EditGroupButton_Click" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 3. PING TAB -->
            <TabItem Header="📡 Ping">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Network Polling &amp; Monitoring" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <CheckBox x:Name="AutostartPingChk" Content="Start pinging automatically after launching the app" FontSize="13" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ping period (seconds):" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="PingPeriodTextBox" Width="60" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 4. NOTIFICATION TAB -->
            <TabItem Header="🔔 Notification">
                <TabControl Margin="0,8,0,0">

                    <!-- Sub-Tab: General Rules -->
                    <TabItem Header="Rules">
                        <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="lstRules" Grid.Column="0" Margin="0,0,12,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="✔️" Foreground="#15803D" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Button x:Name="AddNotifButton" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="AddNotifButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="RemoveNotifButton" HorizontalContentAlignment="Left" Click="RemoveNotifButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="➖" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Remove" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Sub-Tab: Options -->
                    <TabItem Header="Audio &amp; Actions">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="chkSaveToLog" Content="Save alerts to log-file" FontSize="13" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkShowMessage" Content="Show pop-up alert message" FontSize="13" Foreground="#1E293B" Margin="0,0,0,18"/>

                                    <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Sound Alerts" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,12"/>

                                            <!-- Offline Sound -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="EnableOfflineSoundChk" Content="Enable" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Offline:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="SemiBold"/>

                                                <TextBox x:Name="txtOfflineSoundPath" Grid.Column="2" Margin="0,0,8,0" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="📂" Width="34" ToolTip="Browse..." Click="BtnBrowseOffline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>
                                                    <Button Content="▶️" Width="34" Margin="4,0,0,0" ToolTip="Test Sound" Click="BtnTestOffline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Online Sound -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="EnableOnlineSoundChk" Content="Enable" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Online:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="SemiBold"/>

                                                <TextBox x:Name="txtOnlineSoundPath" Grid.Column="2" Margin="0,0,8,0" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="📂" Width="34" ToolTip="Browse..." Click="BtnBrowseOnline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>
                                                    <Button Content="▶️" Width="34" Margin="4,0,0,0" ToolTip="Test Sound" Click="BtnTestOnline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- 5. SEARCH TAB -->
            <TabItem Header="🔍 Search">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Search Depth Mode" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,8"/>
                        <RadioButton x:Name="HeadlinesSearchRB" Content="Use headlines only mode" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6" IsChecked="True"/>
                        <RadioButton x:Name="DeeperSearchRB" Content="Use deeper search mode" FontSize="13" Foreground="#1E293B" Margin="0,0,0,18"/>

                        <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Search Filters" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,8"/>
                                <CheckBox x:Name="EqualityModeCheckBox" Content="Exact equality mode (whole words only)" FontSize="13" Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 6. DB AND PATHS TAB -->
            <TabItem Header="🗄️ DB &amp; Paths">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>

                            <!-- Database Settings -->
                            <TextBlock Text="Database Configuration" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server Instance:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="DatabaseServerTextBox" Grid.Column="1" Text="SQLEXPRESS"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database Name:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="DatabaseNameTextBox" Grid.Column="1" Text="TestDB"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database User:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="DatabaseUserTextBox" Grid.Column="1" Text="TestUser"/>
                            </Grid>

                            <!-- Asset & Script Paths -->
                            <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Storage Paths" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Device Icons Path:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                        <TextBox x:Name="DeviceIconsPathTextBox" Grid.Column="1" Text="C:\Path\To\DeviceIcons"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hint Images Path:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                        <TextBox x:Name="HintImagesPathTextBox" Grid.Column="1" Text="C:\Path\To\HintImages"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Scripts Path:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                        <TextBox x:Name="ScriptsPathTextBox" Grid.Column="1" Text="C:\Path\To\Scripts"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- 7. PASSWORDS TAB -->
            <TabItem Header="🔑 Passwords">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Saved Passwords &amp; Credentials" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="DatabasePasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Printer Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="PrinterPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Grandstream Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="GrandstreamPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VNC Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="VncPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SSH Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="SshPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Managers PC Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="ManagersPcPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="QMS Password:" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                <TextBox x:Name="QmsPasswordTextBox" Grid.Column="1"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <!-- Primary OK Button -->
                <Button Content="OK" Width="110" Margin="0,0,8,0" Click="OkButton_Click" 
                        Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Secondary Cancel Button -->
                <Button Content="Cancel" Width="110" Click="CancelButton_Click" IsCancel="True"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>