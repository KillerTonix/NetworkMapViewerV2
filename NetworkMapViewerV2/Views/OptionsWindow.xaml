<Window x:Class="NetworkMapViewerV2.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkMapViewerV2"
        xmlns:views="clr-namespace:NetworkMapViewerV2.Views"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="OptionsWindow" Height="580" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="480"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTC" Grid.Row="0" Margin="10">
            <TabItem Header="Commands">
                <Border Margin="10" BorderThickness="1">
                    <Grid>
                        <Label Content="External commands list:" VerticalAlignment="Top" />
                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="CommandsListBox" Grid.Column="0" Margin="5" Padding="5" BorderThickness="1" BorderBrush="Black" >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">
                                <Button Click="AddCommandButton_Click" Margin="0,0,0,5" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddCoppyCommandButton_Click" Margin="0,0,0,5" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📑" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add copy" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="RemoveCommandButton_Click" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="EditCommandButton_CLick" Margin="0,5,0,0" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Edit" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="MoveUpCommandButton_Click" Margin="0,5,0,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬆️" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                        <TextBlock Text="Move Up" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button  Click="MoveDownCommandButton_Click" Margin="0,5,0,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                        <TextBlock Text="Move Down" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Device Types">
                <Border Margin="10" BorderThickness="1">
                    <Grid>
                        <Label Content="Manage Custom Device Types:" VerticalAlignment="Top" />
                        <Grid Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="DeviceGroupsListBox" Grid.Column="0" Margin="5" Padding="5" BorderThickness="1" BorderBrush="Black" >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="🖥️" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding DefaultCommand}" Foreground="Gray" FontStyle="Italic"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">
                                <Button Click="AddGroupButton_Click" Margin="0,0,0,5" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="RemoveGroupButton_Click" Margin="0,0,0,5" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="EditGroupButton_Click" Margin="0,5,0,0" HorizontalContentAlignment="Left" Width="90">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Ping">
                <Border Margin="10" >
                    <StackPanel>
                        <Label Content="Ping settings will be here..." />
                        <CheckBox Margin="10" x:Name="AutostartPingChk" Content="Start pinging after launching the app"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <Label Content="Ping period (seconds):"/>
                            <TextBox x:Name="PingPeriodTextBox" Width="50" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Notification">
                <TabControl Margin="10">
                    <TabItem Header="General">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="lstRules" BorderThickness="1" BorderBrush="Black">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="✔️" Foreground="LightGreen" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding TargetName}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button x:Name="AddNotifButton" Margin="0,0,0,5" HorizontalContentAlignment="Left" Width="90" Click="AddNotifButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="RemoveNotifButton" HorizontalContentAlignment="Left" Width="90" Click="RemoveNotifButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Grid>

                    </TabItem>
                    <TabItem Header="Options">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkSaveToLog" Content="Save to log-file" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkShowMessage" Content="Show message" VerticalAlignment="Center"/>
                            </Grid>

                            <GroupBox Grid.Row="2" Header="Play sound" Margin="0,0,0,15" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="EnableOfflineSoundChk" Content="Enable" VerticalAlignment="Center"/>
                                        <Label Grid.Column="1" Content="Offline:" VerticalAlignment="Center"/>

                                        <TextBox x:Name="txtOfflineSoundPath" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📂" Width="30" ToolTip="Browse..." Click="BtnBrowseOffline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>
                                            <Button Content="▶️" Width="30" Margin="5,0,0,0" ToolTip="Test Sound" Click="BtnTestOffline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOfflineSoundChk}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="EnableOnlineSoundChk" Content="Enable" VerticalAlignment="Center"/>
                                        <Label Grid.Column="1" Content="Online:" VerticalAlignment="Center" />

                                        <TextBox x:Name="txtOnlineSoundPath" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📂" Width="30" ToolTip="Browse..." Click="BtnBrowseOnline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>
                                            <Button Content="▶️" Width="30" Margin="5,0,0,0" ToolTip="Test Sound" Click="BtnTestOnline_Click" IsEnabled="{Binding IsChecked, ElementName=EnableOnlineSoundChk}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Search">
                <Border Margin="10" >
                    <StackPanel>
                        <Label Content="Used search depth..." />
                        <RadioButton x:Name="HeadlinesSearchRB" Margin="10" Content="Use headlines only mode" IsChecked="True"/>
                        <RadioButton x:Name="DeeperSearchRB" Margin="10" Content="Use the deeper search mode"/>
                        <Label Content="Search mode..." Margin="0,10,0,0" />
                        <CheckBox x:Name="EqualityModeCheckBox" Margin="10" Content="Equality mode(whole words only)"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="DB and Paths">
                <Border Margin="10" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Database" Margin="10,10,10,10" >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Content="Set database server:" HorizontalAlignment="Left" />
                                    <TextBox x:Name="DatabaseServerTextBox" Text="SQLEXPRESS" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,10,0,10">
                                    <Label Content="Set database name:" HorizontalAlignment="Left" />
                                    <TextBox x:Name="DatabaseNameTextBox" Text="TestDB" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Label Content="Set database user:" HorizontalAlignment="Left" />
                                    <TextBox x:Name="DatabaseUserTextBox" Text="TestUser" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </GroupBox>                
                        <GroupBox Grid.Row="1" Header="Device Icons" Margin="10,10,10,10" >
                            <Grid>
                                <Label Content="Set device icons path:" HorizontalAlignment="Left" />
                                <TextBox x:Name="DeviceIconsPathTextBox" Text="C:\Path\To\DeviceIcons" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="2" Header="Hint Images" Margin="10,10,10,10" >
                            <Grid>
                                <Label Content="Set hint images path:" HorizontalAlignment="Left" />
                                <TextBox x:Name="HintImagesPathTextBox" Text="C:\Path\To\HintImages" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="3" Header="Scripts" Margin="10,10,10,10" >
                            <Grid>
                                <Label Content="Set scripts path:" HorizontalAlignment="Left" />
                                <TextBox x:Name="ScriptsPathTextBox" Text="C:\Path\To\Scripts" Margin="125,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Passwords">
                <Border Margin="10" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="DBPassword" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set database password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="DatabasePasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Printer" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set printer password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="PrinterPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="2" Header="Grandstream" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set grandstream password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="GrandstreamPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="3" Header="VNC" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set VNC password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="VncPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="4" Header="SSH" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set SSH password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="SshPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="5" Header="Managers" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set Managers PC password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="ManagersPcPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="6" Header="QMS" Margin="10,10,10,0" >
                            <Grid>
                                <Label Content="Set QMS password:" HorizontalAlignment="Left" />
                                <TextBox x:Name="QmsPasswordTextBox" Text="" Margin="155,0,10,0" FontSize="12" VerticalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                <Button Content="OK" Width="120" Margin="5,5,25,5" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="120" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
